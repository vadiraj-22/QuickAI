# Port for standalone server mode (Render, Localhost)
PORT=3000

# PostgreSQL Neon Database Connection String
DATABASE_URL=postgresql://user:password@ep-example.neon.tech/neondb?sslmode=require

# Clerk Authentication Keys
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional Clerk JWT Key if using asymmetric verification
CLERK_JWT_KEY=

# Google Gemini API Key
GEMINI_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ClipDrop API Key (for text-to-image and background removal)
CLIPDROP_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Frontend / Client Origin URL for CORS (single or comma-separated)
# Example: https://quick-ai-gray.vercel.app,http://localhost:5173
CLIENT_URL=https://quick-ai-gray.vercel.app
